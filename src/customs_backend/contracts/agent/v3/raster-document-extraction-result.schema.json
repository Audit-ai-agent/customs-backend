{
  "$id": "https://schemas.customs.local/agent/v3/raster-document-extraction-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Human-review-only OCR/layout preview for one immutable rasterized PDF/JPEG/PNG asset. It contains no source bytes and does not authorise automatic review, findings, or customs decisions.",
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      },
      "required": ["x", "y", "width", "height"],
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "required": ["x", "y"],
      "type": "object"
    },
    "Polygon": {
      "additionalProperties": false,
      "properties": {"points": {"type": "array", "minItems": 4, "maxItems": 32, "items": {"$ref": "#/$defs/Point"}}},
      "required": ["points"],
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
      "properties": {
        "span_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 100000},
        "text": {"type": "string", "minLength": 1, "maxLength": 8000},
        "bbox": {"anyOf": [{"$ref": "#/$defs/BoundingBox"}, {"type": "null"}]},
        "polygon": {"anyOf": [{"$ref": "#/$defs/Polygon"}, {"type": "null"}]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reading_order": {"type": "integer", "minimum": 1, "maximum": 100000}
      },
      "required": ["span_id", "ordinal", "text", "bbox", "polygon", "confidence", "reading_order"],
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "page_number": {"type": "integer", "minimum": 1, "maximum": 20},
        "width": {"type": "integer", "minimum": 1, "maximum": 100000},
        "height": {"type": "integer", "minimum": 1, "maximum": 100000},
        "coordinate_unit": {"const": "pixels", "type": "string"},
        "spans": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/Span"}}
      },
      "required": ["page_number", "width", "height", "coordinate_unit", "spans"],
      "type": "object"
    },
    "FieldCandidate": {
      "additionalProperties": false,
      "properties": {
        "field_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"},
        "value": {"type": "string", "minLength": 1, "maxLength": 8000},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_span_ids": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "bbox": {"anyOf": [{"$ref": "#/$defs/BoundingBox"}, {"type": "null"}]}
      },
      "required": ["field_id", "value", "confidence", "evidence_span_ids", "bbox"],
      "type": "object"
    },
    "Cell": {
      "additionalProperties": false,
      "properties": {
        "cell_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "row_index": {"type": "integer", "minimum": 0, "maximum": 100000},
        "column_index": {"type": "integer", "minimum": 0, "maximum": 100000},
        "text": {"type": "string", "minLength": 1, "maxLength": 8000},
        "bbox": {"anyOf": [{"$ref": "#/$defs/BoundingBox"}, {"type": "null"}]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_span_ids": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      },
      "required": ["cell_id", "row_index", "column_index", "text", "bbox", "confidence", "evidence_span_ids"],
      "type": "object"
    },
    "Row": {
      "additionalProperties": false,
      "properties": {
        "row_index": {"type": "integer", "minimum": 0, "maximum": 100000},
        "cells": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/Cell"}}
      },
      "required": ["row_index", "cells"],
      "type": "object"
    },
    "Table": {
      "additionalProperties": false,
      "properties": {
        "table_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "page_number": {"type": "integer", "minimum": 1, "maximum": 20},
        "bbox": {"anyOf": [{"$ref": "#/$defs/BoundingBox"}, {"type": "null"}]},
        "rows": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/Row"}}
      },
      "required": ["table_id", "page_number", "bbox", "rows"],
      "type": "object"
    },
    "Reason": {
      "additionalProperties": false,
      "properties": {"code": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_]{1,127}$"}},
      "required": ["code"],
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {"const": "2.0", "type": "string"},
    "document_asset_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "extraction_request_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "media_type": {"type": "string", "enum": ["application/pdf", "image/jpeg", "image/png"]},
    "byte_size": {"type": "integer", "minimum": 1, "maximum": 33554432},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "raster_profile_revision": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "status": {"type": "string", "enum": ["preview_ready", "needs_review", "unavailable"]},
    "canonical_text_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "extractor_revision": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "document_type": {"type": "string", "enum": ["bill_of_lading", "commercial_invoice", "packing_list", "unknown"]},
    "classification_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "pages": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/Page"}},
    "field_candidates": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/FieldCandidate"}},
    "tables": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/Table"}},
    "warnings": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/Reason"}},
    "needs_review_reasons": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/Reason"}}
  },
  "required": ["schema_version", "document_asset_id", "extraction_request_id", "media_type", "byte_size", "source_sha256", "raster_profile_revision", "status", "canonical_text_sha256", "extractor_revision", "document_type", "classification_confidence", "pages", "field_candidates", "tables", "warnings", "needs_review_reasons"],
  "title": "Customs AI Agent raster document extraction preview result",
  "type": "object"
}
