{
  "$id": "https://schemas.customs.local/agent/v3/raster-text-extraction-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Human-review-only text OCR preview for one immutable rasterized PDF/JPEG/PNG asset. It intentionally contains no layout, field, table, cell, or automatic customs decision.",
  "$defs": {
    "Page": {
      "additionalProperties": false,
      "properties": {
        "page_number": {"type": "integer", "minimum": 1, "maximum": 20},
        "text": {"type": "string", "minLength": 1, "maxLength": 200000},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "required": ["page_number", "text", "confidence"],
      "type": "object"
    },
    "Reason": {
      "additionalProperties": false,
      "properties": {"code": {"type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-z][a-z0-9_]{1,127}$"}},
      "required": ["code"],
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {"const": "1.0", "type": "string"},
    "document_asset_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "extraction_request_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "media_type": {"type": "string", "enum": ["application/pdf", "image/jpeg", "image/png"]},
    "byte_size": {"type": "integer", "minimum": 1, "maximum": 16777216},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "raster_text_profile_revision": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "status": {"type": "string", "enum": ["preview_ready", "needs_review", "unavailable"]},
    "canonical_text": {"type": ["string", "null"], "maxLength": 200000},
    "canonical_text_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "extractor_revision": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "pages": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/Page"}},
    "warnings": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/Reason"}},
    "needs_review_reasons": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/Reason"}}
  },
  "required": ["schema_version", "document_asset_id", "extraction_request_id", "media_type", "byte_size", "source_sha256", "raster_text_profile_revision", "status", "canonical_text", "canonical_text_sha256", "extractor_revision", "pages", "warnings", "needs_review_reasons"],
  "title": "Customs AI Agent raster text extraction preview result",
  "type": "object"
}
