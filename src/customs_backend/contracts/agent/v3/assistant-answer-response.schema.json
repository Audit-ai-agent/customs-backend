{
  "$id": "https://schemas.customs.local/agent/v3/assistant-answer-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One grounded assistant answer. It never mutates Case state, approves a correction, or makes a final customs decision.",
  "$defs": {
    "CaseCitation": {
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["fact", "comparison", "evidence"]},
        "reference_id": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "required": ["kind", "reference_id"],
      "type": "object"
    },
    "GuidanceCitation": {
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "guidance_evidence", "type": "string"},
        "source_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "registry_source_id": {"type": ["string", "null"], "maxLength": 64, "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "source_kind": {"type": "string", "enum": ["official_law", "official_law_catalog", "official_agency_guidance", "official_requirement_reference", "official_public_guidance", "development_fixture"]},
        "source_title": {"type": "string", "minLength": 1, "maxLength": 1000},
        "source_uri": {"type": "string", "minLength": 1, "maxLength": 2000},
        "as_of": {"type": "string", "format": "date"},
        "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "coverage": {"type": "string", "enum": ["covered", "no_coverage", "partial", "unavailable"]},
        "resolution_index": {"type": ["integer", "null"], "minimum": 0, "maximum": 1}
      },
      "required": ["kind", "source_id", "source_kind", "source_title", "source_uri", "as_of", "snapshot_id", "coverage"],
      "type": "object"
    },
    "Citation": {
      "oneOf": [
        {"$ref": "#/$defs/CaseCitation"},
        {"$ref": "#/$defs/GuidanceCitation"}
      ]
    },
    "AnswerSection": {
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["case_analysis", "general_guidance", "case_application"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "content": {"type": "string", "minLength": 1, "maxLength": 4000},
        "citations": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/Citation"}},
        "resolution_index": {"type": ["integer", "null"], "minimum": 0, "maximum": 1}
      },
      "required": ["kind", "title", "content", "citations"],
      "type": "object"
    },
    "CorrectionDraft": {
      "additionalProperties": false,
      "properties": {
        "document_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "item_id": {"type": ["string", "null"], "maxLength": 256},
        "fact_id": {"type": ["string", "null"], "maxLength": 256},
        "field_name": {"type": "string", "minLength": 1, "maxLength": 64},
        "new_value": {"type": "string", "minLength": 1, "maxLength": 2000},
        "unit": {"type": ["string", "null"], "maxLength": 64},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      },
      "required": ["document_id", "field_name", "new_value", "reason"],
      "type": "object"
    },
    "GuidanceResolution": {
      "additionalProperties": false,
      "properties": {
        "topic": {"type": "string", "minLength": 1, "maxLength": 128},
        "scope": {"type": "string", "minLength": 1, "maxLength": 128},
        "requested_direction": {"type": "string", "enum": ["import", "export", "both"]},
        "applicable_directions": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "enum": ["import", "export"]}},
        "coverage": {"type": "string", "enum": ["covered", "no_coverage", "partial", "unavailable"]},
        "snapshot_id": {"type": ["string", "null"], "maxLength": 512},
        "as_of": {"type": "string", "format": "date"},
        "registry_version": {"type": "string", "enum": ["1.0", "2.0"]}
      },
      "required": ["topic", "scope", "requested_direction", "applicable_directions", "coverage", "snapshot_id", "as_of", "registry_version"],
      "type": "object"
    },
    "Engine": {
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["deterministic", "claude"]},
        "model_id": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "required": ["kind", "model_id"],
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {"const": "1.0", "type": "string"},
    "case_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "review_run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "answer_scope": {"type": "string", "enum": ["case_grounded", "evidence_grounded", "general_customs_guidance", "clarification_needed", "insufficient_evidence", "out_of_scope"]},
    "direct_answer": {"type": "string", "minLength": 1, "maxLength": 4000},
    "citations": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/Citation"}},
    "answer_sections": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/AnswerSection"}},
    "suggested_questions": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "correction_draft": {"anyOf": [{"$ref": "#/$defs/CorrectionDraft"}, {"type": "null"}]},
    "guidance_resolution": {"anyOf": [{"$ref": "#/$defs/GuidanceResolution"}, {"type": "null"}]},
    "guidance_resolutions": {"type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/GuidanceResolution"}},
    "answer_format": {"anyOf": [{"const": "multi_scope_checklist", "type": "string"}, {"type": "null"}]},
    "guidance_registry_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "case_input_notice": {"anyOf": [{"const": "unregistered_document_text", "type": "string"}, {"type": "null"}]},
    "engine": {"$ref": "#/$defs/Engine"}
  },
  "required": ["schema_version", "case_id", "review_run_id", "conversation_id", "answer_scope", "direct_answer", "citations", "suggested_questions", "correction_draft", "engine"],
  "title": "Customs AI Agent grounded assistant answer response",
  "type": "object"
}
