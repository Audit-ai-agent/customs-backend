{
  "$id": "https://schemas.customs.local/agent/v3/hs-candidates-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Case-level HSK candidate request: confirmed document text plus the reference codes the Agent may choose among. With items, each goods item carries its own reference list and the Agent ranks per item. The Agent never invents a code.",
  "$defs": {
    "Document": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "document_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "content_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        }
      },
      "required": [
        "document_id",
        "document_type",
        "content_text"
      ],
      "type": "object"
    },
    "ReferenceCandidate": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[0-9]{10}$"
        },
        "name_ko": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "name_en": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "ancestors": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "description": "One goods item the Backend already knows (from the extraction round or its own heuristics) with the reference codes the Agent may rank for it.",
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "document_ids": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string"
          }
        },
        "cited_hs_codes": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{6,10}$"
          }
        },
        "reference_candidates": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/ReferenceCandidate"
          }
        }
      },
      "required": [
        "item_id",
        "description"
      ],
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/Document"
      }
    },
    "reference_candidates": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/ReferenceCandidate"
      }
    },
    "items": {
      "description": "Multi-item ranking round: picks are made per item and max_picks bounds each item; reference_candidates is then ignored.",
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/Item"
      }
    },
    "max_picks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "documents"
  ],
  "title": "Customs AI Agent HSK candidate request",
  "type": "object"
}
