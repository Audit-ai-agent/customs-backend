{
  "$id": "https://schemas.customs.local/agent/v3/hs-candidates-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Case-level HSK candidate request: confirmed document text plus the reference codes the Agent may choose among. The Agent never invents a code.",
  "$defs": {
    "Document": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "document_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "content_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        }
      },
      "required": [
        "document_id",
        "document_type",
        "content_text"
      ],
      "type": "object"
    },
    "ReferenceCandidate": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[0-9]{10}$"
        },
        "name_ko": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "name_en": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "ancestors": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/Document"
      }
    },
    "reference_candidates": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/ReferenceCandidate"
      }
    },
    "max_picks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "documents"
  ],
  "title": "Customs AI Agent HSK candidate request",
  "type": "object"
}
