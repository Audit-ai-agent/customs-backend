{
  "$id": "https://schemas.customs.local/agent/v3/review-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded text-review result. It is always for human review and never an approval or deployment decision.",
  "$defs": {
    "Source": {
      "additionalProperties": false,
      "properties": {
        "source_kind": {"const": "document", "type": "string"},
        "document_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "quote": {"type": "string", "minLength": 1, "maxLength": 4000},
        "occurrence": {"type": "integer", "minimum": 0, "maximum": 100000}
      },
      "required": ["source_kind", "document_id", "quote", "occurrence"],
      "type": "object"
    },
    "HumanProvidedSource": {
      "additionalProperties": false,
      "properties": {
        "source_kind": {"const": "human_provided", "type": "string"},
        "document_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "correction_proposal_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      },
      "required": ["source_kind", "document_id", "correction_proposal_id", "reason"],
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "raw_value": {"type": "string", "minLength": 1, "maxLength": 2000},
        "normalized_value": {"type": ["string", "null"], "maxLength": 2000},
        "unit": {"type": ["string", "null"], "maxLength": 64},
        "source": {"anyOf": [{"$ref": "#/$defs/Source"}, {"$ref": "#/$defs/HumanProvidedSource"}]}
      },
      "required": ["fact_id", "name", "raw_value", "normalized_value", "unit", "source"],
      "type": "object"
    },
    "LineItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "source": {"$ref": "#/$defs/Source"},
        "facts": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/Fact"}}
      },
      "required": ["item_id", "source", "facts"],
      "type": "object"
    },
    "ExtractionWarning": {
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "message": {"type": "string", "minLength": 1, "maxLength": 1000}
      },
      "required": ["code", "message"],
      "type": "object"
    },
    "DocumentAnalysis": {
      "additionalProperties": false,
      "properties": {
        "document_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "filename": {"type": "string", "minLength": 1, "maxLength": 255},
        "declared_type": {"type": ["string", "null"], "maxLength": 64},
        "document_type": {"type": "string", "enum": ["invoice", "packing_list", "bill_of_lading", "certificate_of_origin", "air_waybill", "export_declaration", "supporting_evidence", "unknown"]},
        "classification_source": {"anyOf": [{"$ref": "#/$defs/Source"}, {"type": "null"}]},
        "extraction_status": {"type": "string", "enum": ["complete", "needs_review"]},
        "facts": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/Fact"}},
        "line_items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/LineItem"}},
        "warnings": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/ExtractionWarning"}},
        "extraction_source": {"type": ["string", "null"], "enum": ["text_layer", "vlm_ocr", "raster_ocr", null]}
      },
      "required": ["document_id", "filename", "declared_type", "document_type", "classification_source", "extraction_status", "facts", "line_items", "warnings"],
      "type": "object"
    },
    "ComparisonOperand": {
      "additionalProperties": false,
      "properties": {
        "document_id": {"type": ["string", "null"], "maxLength": 128},
        "item_id": {"type": ["string", "null"], "maxLength": 256},
        "fact_ids": {"type": "array", "maxItems": 8, "items": {"type": "string"}},
        "display_value": {"type": ["string", "null"], "maxLength": 4000}
      },
      "required": ["document_id", "item_id", "fact_ids", "display_value"],
      "type": "object"
    },
    "Comparison": {
      "additionalProperties": false,
      "properties": {
        "comparison_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "rule_code": {"type": "string", "minLength": 1, "maxLength": 128},
        "status": {"type": "string", "enum": ["pass", "skip", "mismatch", "needs_review"]},
        "left": {"$ref": "#/$defs/ComparisonOperand"},
        "right": {"$ref": "#/$defs/ComparisonOperand"},
        "expected_value": {"type": ["string", "null"], "maxLength": 2000},
        "observed_value": {"type": ["string", "null"], "maxLength": 2000},
        "unit": {"type": ["string", "null"], "maxLength": 64},
        "message": {"type": "string", "minLength": 1, "maxLength": 4000}
      },
      "required": ["comparison_id", "rule_code", "status", "left", "right", "expected_value", "observed_value", "unit", "message"],
      "type": "object"
    },
    "Reextraction": {
      "additionalProperties": false,
      "properties": {
        "document_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "attempt_count": {"type": "integer", "const": 1},
        "requested_fields": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string"}},
        "status": {"type": "string", "enum": ["completed", "unavailable"]}
      },
      "required": ["document_id", "attempt_count", "requested_fields", "status"],
      "type": "object"
    },
    "WorkflowStage": {
      "additionalProperties": false,
      "properties": {
        "stage": {"type": "string", "enum": ["classify_documents", "extract_facts", "normalize_facts", "match_documents", "validate_documents", "reextract_documents", "retrieve_evidence", "generate_result"]},
        "status": {"type": "string", "enum": ["completed", "skipped", "needs_review", "failed"]},
        "attempt_count": {"type": "integer", "minimum": 0, "maximum": 40},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000}
      },
      "required": ["stage", "status", "attempt_count", "summary"],
      "type": "object"
    },
    "Workflow": {
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string", "enum": ["completed", "partial", "failed"]},
        "stages": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/WorkflowStage"}},
        "reextractions": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/Reextraction"}},
        "planner": {"$ref": "#/$defs/PlannerTrace"},
        "graph_trace": {"anyOf": [{"$ref": "#/$defs/GraphTrace"}, {"type": "null"}]}
      },
      "required": ["status", "stages", "reextractions", "planner"],
      "type": "object"
    },
    "PlannerAction": {
      "additionalProperties": false,
      "properties": {
        "cycle": {"type": "integer", "minimum": 1, "maximum": 2},
        "action": {"type": "string", "enum": ["analyze_documents", "apply_human_corrections", "compare_documents", "reextract_documents", "retrieve_evidence", "generate_report"]},
        "status": {"type": "string", "enum": ["completed", "skipped", "needs_review", "failed"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "correction_proposal_ids": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      },
      "required": ["cycle", "action", "status", "summary", "correction_proposal_ids"],
      "type": "object"
    },
    "PlannerTrace": {
      "additionalProperties": false,
      "properties": {
        "cycle_count": {"type": "integer", "minimum": 1, "maximum": 2},
        "actions": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/PlannerAction"}}
      },
      "required": ["cycle_count", "actions"],
      "type": "object"
    },
    "GraphNodeRun": {
      "additionalProperties": false,
      "description": "One executed node of the LangGraph review graph.",
      "properties": {
        "node": {"type": "string", "enum": ["extraction_agent", "cross_validation_agent", "evidence_retrieval", "expert_review_agent", "report_generation"]},
        "iteration": {"type": "integer", "minimum": 1, "maximum": 2},
        "status": {"type": "string", "enum": ["completed", "needs_review", "skipped", "failed"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000}
      },
      "required": ["node", "iteration", "status", "summary"],
      "type": "object"
    },
    "GraphTrace": {
      "additionalProperties": false,
      "description": "Node trace of the LangGraph review graph. The audit loop re-enters extraction and cross-validation at most once.",
      "properties": {
        "framework": {"const": "langgraph", "type": "string"},
        "iteration_count": {"type": "integer", "minimum": 1, "maximum": 2},
        "loop_reason": {"type": ["string", "null"], "enum": ["missing_fields", "ungrounded_fields", "mismatch_reread", "llm_reread_request", null]},
        "node_runs": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/GraphNodeRun"}}
      },
      "required": ["framework", "iteration_count", "loop_reason", "node_runs"],
      "type": "object"
    },
    "Action": {
      "additionalProperties": false,
      "properties": {
        "action_code": {"type": "string", "minLength": 1, "maxLength": 128},
        "message": {"type": "string", "minLength": 1, "maxLength": 4000},
        "finding_ids": {"type": "array", "maxItems": 256, "items": {"type": "string"}}
      },
      "required": ["action_code", "message", "finding_ids"],
      "type": "object"
    },
    "Orchestrator": {
      "additionalProperties": false,
      "properties": {
        "framework": {"const": "langgraph", "type": "string"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      },
      "required": ["framework", "version"],
      "type": "object"
    },
    "Engine": {
      "additionalProperties": false,
      "description": "kind names the actual LLM provider. \"claude\" is accepted only for results persisted before 3.3.",
      "properties": {
        "kind": {"enum": ["deterministic", "anthropic", "openai", "claude"], "type": "string"},
        "model_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "orchestrator": {"anyOf": [{"$ref": "#/$defs/Orchestrator"}, {"type": "null"}]}
      },
      "required": ["kind", "model_id"],
      "type": "object"
    },
    "ConfidenceComponents": {
      "additionalProperties": false,
      "properties": {
        "extraction": {"type": "number", "minimum": 0, "maximum": 1},
        "comparison": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "required": ["extraction", "comparison", "evidence"],
      "type": "object"
    },
    "Confidence": {
      "additionalProperties": false,
      "description": "Deterministic confidence and the review track it selects. Both tracks are human-reviewed.",
      "properties": {
        "overall": {"type": "number", "minimum": 0, "maximum": 1},
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "review_track": {"type": "string", "enum": ["detailed_review", "expedited_check"]},
        "method": {"const": "deterministic_signals", "type": "string"},
        "components": {"$ref": "#/$defs/ConfidenceComponents"}
      },
      "required": ["overall", "threshold", "review_track", "method", "components"],
      "type": "object"
    },
    "EligibilityReason": {
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "message": {"type": "string", "minLength": 1, "maxLength": 2000},
        "finding_ids": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
        "evidence_ids": {"type": "array", "maxItems": 64, "items": {"type": "string"}}
      },
      "required": ["code", "message", "finding_ids", "evidence_ids"],
      "type": "object"
    },
    "EligibilityVerdict": {
      "additionalProperties": false,
      "description": "Advisory clearance verdict. It never closes a case; requires_human_review stays true.",
      "properties": {
        "verdict": {"type": "string", "enum": ["eligible", "ineligible", "indeterminate"]},
        "advisory": {"const": true, "type": "boolean"},
        "source": {"type": "string", "enum": ["rule", "rule+llm"]},
        "reasons": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/EligibilityReason"}}
      },
      "required": ["verdict", "advisory", "source", "reasons"],
      "type": "object"
    },
    "FindingClassification": {
      "additionalProperties": false,
      "description": "Error-type label for one finding; it never changes the rule verdict.",
      "properties": {
        "error_category": {"type": "string", "enum": ["value_mismatch", "missing_field", "unit_or_format", "document_type_uncertain", "regulatory_requirement", "other"]},
        "explanation": {"type": "string", "minLength": 1, "maxLength": 2000},
        "source": {"type": "string", "enum": ["rule", "llm"]}
      },
      "required": ["error_category", "explanation", "source"],
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "item_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "law_id": {"type": ["string", "null"], "maxLength": 512},
        "law_name": {"type": ["string", "null"], "maxLength": 2000},
        "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_uri": {"type": "string", "minLength": 1, "maxLength": 4000},
        "text": {"type": "string", "minLength": 1, "maxLength": 20000},
        "title": {"type": "string", "minLength": 1, "maxLength": 2000}
      },
      "required": ["evidence_id", "item_id", "title", "text", "source_uri", "source_type", "source_hash", "law_id", "law_name"],
      "type": "object"
    },
    "TemporalContext": {
      "additionalProperties": false,
      "properties": {
        "law_as_of": {"type": "string", "format": "date"},
        "hsk_snapshot_as_of": {"type": "string", "format": "date"},
        "requirements_snapshot_as_of": {"type": "string", "format": "date"}
      },
      "required": ["law_as_of", "hsk_snapshot_as_of", "requirements_snapshot_as_of"],
      "type": "object"
    },
    "TemporalCoverage": {
      "additionalProperties": false,
      "properties": {
        "law": {"type": "string", "enum": ["covered", "unavailable"]},
        "hsk": {"type": "string", "enum": ["covered", "unavailable"]},
        "requirements": {"type": "string", "enum": ["covered", "unavailable"]}
      },
      "required": ["law", "hsk", "requirements"],
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "kind": {"enum": ["validation_issue", "regulatory_finding"], "type": "string"},
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "severity": {"enum": ["low", "medium", "high", "critical"], "type": "string"},
        "message": {"type": "string", "minLength": 1, "maxLength": 4000},
        "item_id": {"type": ["string", "null"], "maxLength": 128},
        "evidence_ids": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "comparison_id": {"type": ["string", "null"], "maxLength": 256},
        "document_ids": {"type": "array", "maxItems": 20, "items": {"type": "string"}},
        "fact_ids": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "classification": {"anyOf": [{"$ref": "#/$defs/FindingClassification"}, {"type": "null"}]}
      },
      "required": ["finding_id", "kind", "code", "severity", "message", "item_id", "evidence_ids", "comparison_id", "document_ids", "fact_ids"],
      "type": "object"
    },
    "Report": {
      "additionalProperties": false,
      "properties": {
        "disclaimer": {"type": "string", "minLength": 1, "maxLength": 2000},
        "overall_status": {"enum": ["needs_review", "blocked"], "type": "string"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
        "sections": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/ReportSection"}}
      },
      "required": ["overall_status", "summary", "disclaimer", "sections"],
      "type": "object"
    },
    "ReportClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "fact_ids": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
        "comparison_ids": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
        "evidence_ids": {"type": "array", "maxItems": 64, "items": {"type": "string"}}
      },
      "required": ["claim_id", "text", "fact_ids", "comparison_ids", "evidence_ids"],
      "type": "object"
    },
    "ReportSection": {
      "additionalProperties": false,
      "properties": {
        "section": {"type": "string", "enum": ["conclusion", "execution_process", "document_comparison", "issues_and_causes", "legal_evidence", "impact", "next_actions", "limitations"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 128},
        "claims": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/ReportClaim"}}
      },
      "required": ["section", "title", "claims"],
      "type": "object"
    }
  },
  "properties": {
    "assessment": {"enum": ["no_issue_detected", "issues_detected", "indeterminate"], "type": "string"},
    "case_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "engine": {"anyOf": [{"$ref": "#/$defs/Engine"}, {"type": "null"}]},
    "evidence": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/Evidence"}},
    "execution_status": {"enum": ["succeeded", "partial", "failed"], "type": "string"},
    "findings": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/Finding"}},
    "input_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "jurisdiction": {"const": "KR", "type": "string"},
    "report": {"$ref": "#/$defs/Report"},
    "temporal_context": {"anyOf": [{"$ref": "#/$defs/TemporalContext"}, {"type": "null"}]},
    "temporal_coverage": {"anyOf": [{"$ref": "#/$defs/TemporalCoverage"}, {"type": "null"}]},
    "confidence": {"anyOf": [{"$ref": "#/$defs/Confidence"}, {"type": "null"}]},
    "eligibility_verdict": {"anyOf": [{"$ref": "#/$defs/EligibilityVerdict"}, {"type": "null"}]},
    "workflow": {"$ref": "#/$defs/Workflow"},
    "document_analyses": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/DocumentAnalysis"}},
    "comparisons": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/Comparison"}},
    "required_actions": {"type": "array", "minItems": 1, "maxItems": 2001, "items": {"$ref": "#/$defs/Action"}},
    "requires_human_review": {"const": true, "type": "boolean"},
    "result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "review_as_of": {"type": "string", "format": "date"},
    "review_run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "schema_version": {"const": "3.3", "type": "string"},
    "status": {"enum": ["needs_review", "blocked"], "type": "string"},
    "trade_type": {"enum": ["import", "export"], "type": "string"}
  },
  "required": ["case_id", "review_run_id", "review_as_of", "trade_type", "jurisdiction", "status", "requires_human_review", "execution_status", "assessment", "input_manifest_sha256", "report", "workflow", "document_analyses", "comparisons", "evidence", "findings", "required_actions", "result_sha256", "schema_version"],
  "title": "Customs AI Agent bounded functional review result",
  "type": "object"
}
