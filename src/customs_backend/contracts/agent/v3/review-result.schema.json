{
  "$id": "https://schemas.customs.local/agent/v3/review-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Functional review result. It is always for human review and never a deployment decision.",
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "action_code": {"type": "string", "minLength": 1, "maxLength": 128},
        "message": {"type": "string", "minLength": 1, "maxLength": 4000}
      },
      "required": ["action_code", "message"],
      "type": "object"
    },
    "Engine": {
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["deterministic", "claude"], "type": "string"},
        "model_id": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "required": ["kind", "model_id"],
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "item_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "law_id": {"type": ["string", "null"], "maxLength": 512},
        "law_name": {"type": ["string", "null"], "maxLength": 2000},
        "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_uri": {"type": "string", "minLength": 1, "maxLength": 4000},
        "text": {"type": "string", "minLength": 1, "maxLength": 20000},
        "title": {"type": "string", "minLength": 1, "maxLength": 2000}
      },
      "required": ["evidence_id", "item_id", "title", "text", "source_uri", "source_type", "source_hash"],
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "evidence_ids": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "item_id": {"type": ["string", "null"], "maxLength": 128},
        "kind": {"enum": ["validation_issue", "regulatory_finding"], "type": "string"},
        "message": {"type": "string", "minLength": 1, "maxLength": 4000},
        "severity": {"enum": ["low", "medium", "high", "critical"], "type": "string"}
      },
      "required": ["kind", "code", "severity", "message", "item_id", "evidence_ids"],
      "type": "object"
    },
    "Report": {
      "additionalProperties": false,
      "properties": {
        "disclaimer": {"type": "string", "minLength": 1, "maxLength": 2000},
        "overall_status": {"enum": ["needs_review", "blocked"], "type": "string"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4000}
      },
      "required": ["overall_status", "summary", "disclaimer"],
      "type": "object"
    }
  },
  "properties": {
    "assessment": {"enum": ["no_issue_detected", "issues_detected", "indeterminate"], "type": "string"},
    "case_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "engine": {"$ref": "#/$defs/Engine"},
    "evidence": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/Evidence"}},
    "execution_status": {"enum": ["succeeded", "partial", "failed"], "type": "string"},
    "findings": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/Finding"}},
    "input_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "jurisdiction": {"const": "KR", "type": "string"},
    "report": {"$ref": "#/$defs/Report"},
    "required_actions": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/Action"}},
    "requires_human_review": {"const": true, "type": "boolean"},
    "result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "review_as_of": {"type": "string", "format": "date"},
    "review_run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "schema_version": {"const": "3.0", "type": "string"},
    "status": {"enum": ["needs_review", "blocked"], "type": "string"},
    "trade_type": {"enum": ["import", "export"], "type": "string"}
  },
  "required": ["case_id", "review_run_id", "review_as_of", "trade_type", "jurisdiction", "status", "requires_human_review", "execution_status", "assessment", "input_manifest_sha256", "report", "evidence", "findings", "required_actions", "result_sha256"],
  "title": "Customs AI Agent functional review result",
  "type": "object"
}
