{
  "$defs": {
    "ImagePageInput": {
      "additionalProperties": false,
      "description": "One validated, already-rasterized page supplied to Claude Vision.\n\n`data_base64` is part of the in-memory wire request but is excluded from repr.\nThe model verifies bytes, media type, dimensions and hash before any provider\nor Evidence Service call.",
      "properties": {
        "byte_length": {
          "maximum": 5242880,
          "minimum": 1,
          "title": "Byte Length",
          "type": "integer"
        },
        "data_base64": {
          "maxLength": 6990508,
          "minLength": 4,
          "title": "Data Base64",
          "type": "string"
        },
        "height_px": {
          "maximum": 2576,
          "minimum": 1,
          "title": "Height Px",
          "type": "integer"
        },
        "media_type": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "page_number": {
          "maximum": 50,
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "provenance": {
          "$ref": "#/$defs/ImagePageProvenance"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "width_px": {
          "maximum": 2576,
          "minimum": 1,
          "title": "Width Px",
          "type": "integer"
        }
      },
      "required": [
        "page_number",
        "media_type",
        "data_base64",
        "byte_length",
        "sha256",
        "width_px",
        "height_px",
        "provenance"
      ],
      "title": "ImagePageInput",
      "type": "object"
    },
    "ImagePageProvenance": {
      "additionalProperties": false,
      "description": "Trace the validated page bytes back to their immutable source.",
      "properties": {
        "original_exif_orientation": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Exif Orientation"
        },
        "raster_dpi": {
          "anyOf": [
            {
              "maximum": 600,
              "minimum": 72,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raster Dpi"
        },
        "rasterizer_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rasterizer Id"
        },
        "rasterizer_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rasterizer Version"
        },
        "source_media_type": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "application/pdf"
          ],
          "title": "Source Media Type",
          "type": "string"
        },
        "source_page_number": {
          "minimum": 1,
          "title": "Source Page Number",
          "type": "integer"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "transforms": {
          "items": {
            "enum": [
              "exif_transpose",
              "metadata_strip",
              "pdf_rasterize"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Transforms",
          "type": "array"
        }
      },
      "required": [
        "source_media_type",
        "source_sha256",
        "source_page_number"
      ],
      "title": "ImagePageProvenance",
      "type": "object"
    },
    "SupportingDocumentV1": {
      "additionalProperties": false,
      "properties": {
        "document_code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Document Code",
          "type": "string"
        },
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Document Id",
          "type": "string"
        },
        "document_number": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Document Number",
          "type": "string"
        },
        "hs_codes": {
          "items": {
            "pattern": "^[0-9]{10}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Hs Codes",
          "type": "array"
        },
        "issued_on": {
          "format": "date",
          "title": "Issued On",
          "type": "string"
        },
        "issuer": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Issuer",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "subject_item_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Subject Item Ids",
          "type": "array"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "verification_assertions": {
          "items": {
            "$ref": "#/$defs/VerificationAssertionV1"
          },
          "maxItems": 20,
          "title": "Verification Assertions",
          "type": "array"
        }
      },
      "required": [
        "document_id",
        "document_code",
        "issuer",
        "document_number",
        "issued_on",
        "subject_item_ids",
        "source_sha256"
      ],
      "title": "SupportingDocumentV1",
      "type": "object"
    },
    "TextDocumentInputV3": {
      "additionalProperties": false,
      "description": "V3 text wire; empty Backend visual defaults are allowed, payloads are not.",
      "oneOf": [
        {
          "properties": {
            "content_text": {
              "minLength": 1,
              "type": "string"
            },
            "image_pages": {
              "maxItems": 0,
              "type": "array"
            },
            "pdf_pages": {
              "type": "null"
            }
          },
          "required": [
            "content_text"
          ]
        },
        {
          "properties": {
            "content_text": {
              "type": "null"
            },
            "image_pages": {
              "minItems": 1,
              "type": "array"
            },
            "pdf_pages": {
              "type": "null"
            }
          },
          "required": [
            "image_pages"
          ]
        },
        {
          "properties": {
            "content_text": {
              "type": "null"
            },
            "image_pages": {
              "maxItems": 0,
              "type": "array"
            },
            "pdf_pages": {
              "type": "object"
            }
          },
          "required": [
            "pdf_pages"
          ]
        }
      ],
      "properties": {
        "content_text": {
          "maxLength": 200000,
          "minLength": 1,
          "title": "Content Text",
          "type": "string"
        },
        "declared_type": {
          "anyOf": [
            {
              "enum": [
                "bill_of_lading",
                "invoice",
                "packing_list",
                "certificate_of_origin",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Type"
        },
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Document Id",
          "type": "string"
        },
        "filename": {
          "maxLength": 255,
          "minLength": 1,
          "not": {
            "enum": [
              ".",
              ".."
            ]
          },
          "pattern": "^[^/\\\\:\\s\\x00-\\x1f\\x7f](?:[^/\\\\:\\x00-\\x1f\\x7f]*[^/\\\\:\\s\\x00-\\x1f\\x7f])?$",
          "title": "Filename",
          "type": "string"
        },
        "image_pages": {
          "items": {
            "$ref": "#/$defs/ImagePageInput"
          },
          "maxItems": 0,
          "title": "Image Pages",
          "type": "array"
        },
        "pdf_pages": {
          "default": null,
          "title": "Pdf Pages",
          "type": "null"
        },
        "requirement_document_codes": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Requirement Document Codes",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "document_id",
        "filename",
        "content_text"
      ],
      "title": "TextDocumentInputV3",
      "type": "object"
    },
    "VerificationAssertionV1": {
      "additionalProperties": false,
      "properties": {
        "asserted_at": {
          "format": "date-time",
          "title": "Asserted At",
          "type": "string"
        },
        "asserted_by": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Asserted By",
          "type": "string"
        },
        "assertion_id": {
          "pattern": "^assert_[a-f0-9]{64}$",
          "title": "Assertion Id",
          "type": "string"
        },
        "authority_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Authority Id",
          "type": "string"
        },
        "authority_release": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Authority Release",
          "type": "string"
        },
        "method": {
          "enum": [
            "trusted_connector",
            "human_approver",
            "test_issuer"
          ],
          "title": "Method",
          "type": "string"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerificationReceiptV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_reference_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Reference Sha256",
          "type": "string"
        },
        "subject_document_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Subject Document Id",
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "method",
        "subject_document_id",
        "asserted_by",
        "asserted_at",
        "authority_id",
        "authority_release",
        "source_reference_sha256"
      ],
      "title": "VerificationAssertionV1",
      "type": "object"
    },
    "VerificationReceiptV1": {
      "additionalProperties": false,
      "description": "Detached, case-bound proof produced by Backend or a trusted connector.",
      "properties": {
        "authority_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Authority Id",
          "type": "string"
        },
        "authority_release": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Authority Release",
          "type": "string"
        },
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "connector_result_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connector Result Sha256"
        },
        "decision_record_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Record Sha256"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "key_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Key Id",
          "type": "string"
        },
        "method": {
          "enum": [
            "trusted_connector",
            "human_approver"
          ],
          "title": "Method",
          "type": "string"
        },
        "policy_release": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Policy Release",
          "type": "string"
        },
        "policy_source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Policy Source Sha256",
          "type": "string"
        },
        "signature_base64url": {
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "title": "Signature Base64Url",
          "type": "string"
        },
        "signed_at": {
          "format": "date-time",
          "title": "Signed At",
          "type": "string"
        },
        "supporting_document_claims_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Supporting Document Claims Sha256",
          "type": "string"
        },
        "trust_domain": {
          "const": "customs-ai-agent/supporting-document-verification/v1",
          "title": "Trust Domain",
          "type": "string"
        }
      },
      "required": [
        "trust_domain",
        "case_id",
        "method",
        "authority_id",
        "authority_release",
        "key_id",
        "supporting_document_claims_sha256",
        "policy_source_sha256",
        "policy_release",
        "signed_at",
        "expires_at",
        "signature_base64url"
      ],
      "title": "VerificationReceiptV1",
      "type": "object"
    }
  },
  "$id": "https://schemas.customs.local/agent/v3/review-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Additive V3 request with independently asserted supporting-document metadata. The text-first service transport rejects image and PDF modalities before Claude.",
  "properties": {
    "assertion_cutoff_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assertion Cutoff At"
    },
    "case_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Case Id",
      "type": "string"
    },
    "document_language": {
      "default": "unknown",
      "enum": [
        "unknown",
        "ko",
        "en"
      ],
      "title": "Document Language",
      "type": "string"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/TextDocumentInputV3"
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Documents",
      "type": "array"
    },
    "jurisdiction": {
      "const": "KR",
      "default": "KR",
      "title": "Jurisdiction",
      "type": "string"
    },
    "llm_mode": {
      "const": "llm",
      "title": "Llm Mode",
      "type": "string"
    },
    "review_as_of": {
      "format": "date",
      "title": "Review As Of",
      "type": "string"
    },
    "review_run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Review Run Id",
      "type": "string"
    },
    "supporting_documents": {
      "items": {
        "$ref": "#/$defs/SupportingDocumentV1"
      },
      "maxItems": 100,
      "title": "Supporting Documents",
      "type": "array"
    },
    "trade_type": {
      "default": "import",
      "enum": [
        "import",
        "export"
      ],
      "title": "Trade Type",
      "type": "string"
    },
    "uploaded_requirement_document_codes": {
      "items": {
        "type": "string"
      },
      "maxItems": 0,
      "title": "Uploaded Requirement Document Codes",
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "documents",
    "llm_mode"
  ],
  "title": "Customs AI Agent V3 review request",
  "type": "object"
}
