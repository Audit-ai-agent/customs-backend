{
  "$id": "https://schemas.customs.local/agent/v3/review-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Text-only request for one human-review Agent pass. Approved human corrections are append-only context for a child run and never alter an original document.",
  "$defs": {
    "LayoutSummary": {
      "additionalProperties": false,
      "description": "Counts from the OCR + layout pass that produced the confirmed text.",
      "properties": {
        "page_count": {"type": "integer", "minimum": 0, "maximum": 1000},
        "table_count": {"type": "integer", "minimum": 0, "maximum": 10000},
        "span_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "field_candidate_count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "mean_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "required": ["page_count", "table_count", "span_count", "field_candidate_count"],
      "type": "object"
    },
    "DocumentExtraction": {
      "additionalProperties": false,
      "description": "Provenance of content_text: born-digital text layer, VLM OCR, or the raster OCR + layout engine.",
      "properties": {
        "source": {"type": "string", "enum": ["text_layer", "vlm_ocr", "raster_ocr"]},
        "layout_summary": {"anyOf": [{"$ref": "#/$defs/LayoutSummary"}, {"type": "null"}]}
      },
      "required": ["source"],
      "type": "object"
    },
    "Document": {
      "additionalProperties": false,
      "properties": {
        "content_text": {"type": "string", "minLength": 1, "maxLength": 200000},
        "declared_type": {"type": ["string", "null"], "maxLength": 64},
        "document_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "filename": {"type": "string", "minLength": 1, "maxLength": 255},
        "extraction": {"anyOf": [{"$ref": "#/$defs/DocumentExtraction"}, {"type": "null"}]}
      },
      "required": ["document_id", "filename", "content_text"],
      "type": "object"
    },
    "HumanCorrection": {
      "additionalProperties": false,
      "properties": {
        "correction_proposal_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "document_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "item_id": {"type": ["string", "null"], "maxLength": 256},
        "fact_id": {"type": ["string", "null"], "maxLength": 256},
        "field_name": {"type": "string", "minLength": 1, "maxLength": 64},
        "new_value": {"type": "string", "minLength": 1, "maxLength": 2000},
        "unit": {"type": ["string", "null"], "maxLength": 64},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "source_kind": {"const": "human_provided", "type": "string"}
      },
      "required": ["correction_proposal_id", "document_id", "field_name", "new_value", "reason", "source_kind"],
      "type": "object"
    },
    "ReviewerHsSelection": {
      "additionalProperties": false,
      "description": "Reviewer-confirmed HSK code, labelled human-provided context. It never overrides a document-cited HS code; the Agent may use it to complete a shorter document-cited prefix, as the retrieval commodity for the goods item it names (item_id/description, multi-item cases), or as the only retrieval commodity when no input document cites a code.",
      "properties": {
        "code": {"type": "string", "pattern": "^[0-9]{10}$"},
        "source_kind": {"const": "human_provided", "type": "string"},
        "item_id": {"type": ["string", "null"], "maxLength": 64},
        "description": {"type": ["string", "null"], "maxLength": 300}
      },
      "required": ["code", "source_kind"],
      "type": "object"
    }
  },
  "properties": {
    "case_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "documents": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/Document"}},
    "jurisdiction": {"const": "KR", "type": "string"},
    "review_as_of": {"type": "string", "format": "date"},
    "review_run_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "trade_type": {"enum": ["import", "export"], "type": "string"},
    "parent_review_run_id": {"type": ["string", "null"], "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "applied_correction_proposal_ids": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "human_corrections": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/HumanCorrection"}},
    "reviewer_hs_selection": {"anyOf": [{"$ref": "#/$defs/ReviewerHsSelection"}, {"type": "null"}]},
    "reviewer_hs_selections": {
      "description": "Every reviewer-confirmed code, one per goods item, when the case has several items; reviewer_hs_selection stays the newest of them for older Agents.",
      "type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/ReviewerHsSelection"}
    },
    "parent_document_analyses": {
      "description": "Child run only: the parent run's document_analyses, exactly as returned in its review result. The Agent validates them against the unchanged input documents and reuses them instead of extracting again; approved human corrections are then appended.",
      "anyOf": [{"type": "array", "maxItems": 20, "items": {"type": "object"}}, {"type": "null"}]
    }
  },
  "required": ["case_id", "review_run_id", "review_as_of", "trade_type", "jurisdiction", "documents"],
  "title": "Customs AI Agent functional review request",
  "type": "object"
}
