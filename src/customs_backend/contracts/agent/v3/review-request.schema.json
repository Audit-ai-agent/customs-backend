{
  "$id": "https://schemas.customs.local/agent/v3/review-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Text-only request for one human-review Agent pass.",
  "$defs": {
    "Document": {
      "additionalProperties": false,
      "properties": {
        "content_text": {"type": "string", "minLength": 1, "maxLength": 200000},
        "declared_type": {"type": ["string", "null"], "maxLength": 64},
        "document_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "filename": {"type": "string", "minLength": 1, "maxLength": 255}
      },
      "required": ["document_id", "filename", "content_text"],
      "type": "object"
    }
  },
  "properties": {
    "case_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "documents": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/Document"}},
    "jurisdiction": {"const": "KR", "type": "string"},
    "review_as_of": {"type": "string", "format": "date"},
    "review_run_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "trade_type": {"enum": ["import", "export"], "type": "string"}
  },
  "required": ["case_id", "review_run_id", "review_as_of", "trade_type", "jurisdiction", "documents"],
  "title": "Customs AI Agent functional review request",
  "type": "object"
}
