{
  "$id": "https://schemas.customs.local/agent/v3/knowledge-answer-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One bounded official-trade guidance turn. It has no Case or Review Run input.",
  "$defs": {
    "RecentTurn": {
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string", "enum": ["user", "assistant"]},
        "content": {"type": "string", "minLength": 1, "maxLength": 4000}
      },
      "required": ["role", "content"],
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {"const": "1.0", "type": "string"},
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "question": {"type": "string", "minLength": 1, "maxLength": 4000},
    "trade_type": {"type": "string", "enum": ["import", "export", "both"]},
    "recent_turns": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/RecentTurn"}},
    "as_of": {"type": "string", "format": "date"},
    "expected_snapshot_id": {"type": ["string", "null"], "minLength": 3, "maxLength": 81, "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"}
  },
  "required": ["schema_version", "conversation_id", "question", "trade_type", "recent_turns", "as_of"],
  "title": "Customs AI Agent official-trade knowledge answer request",
  "type": "object"
}
