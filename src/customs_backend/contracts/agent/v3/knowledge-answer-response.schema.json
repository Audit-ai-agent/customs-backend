{
  "$id": "https://schemas.customs.local/agent/v3/knowledge-answer-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One official-snapshot grounded guidance answer. It never receives Case facts or mutates Case state.",
  "$defs": {
    "GuidanceCitation": {
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "guidance_evidence", "type": "string"},
        "source_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_kind": {"type": "string", "enum": ["official_law", "official_law_catalog", "official_agency_guidance", "official_requirement_reference", "official_public_guidance", "development_fixture"]},
        "source_title": {"type": "string", "minLength": 1, "maxLength": 1000},
        "source_uri": {"type": "string", "minLength": 1, "maxLength": 2000},
        "as_of": {"type": "string", "format": "date"},
        "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "coverage": {"type": "string", "enum": ["covered", "no_coverage", "partial", "unavailable"]}
      },
      "required": ["kind", "source_id", "source_kind", "source_title", "source_uri", "as_of", "snapshot_id", "coverage"],
      "type": "object"
    },
    "AnswerSection": {
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "general_guidance", "type": "string"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "content": {"type": "string", "minLength": 1, "maxLength": 4000},
        "citations": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/GuidanceCitation"}}
      },
      "required": ["kind", "title", "content", "citations"],
      "type": "object"
    },
    "Engine": {
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["deterministic", "claude"]},
        "model_id": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "required": ["kind", "model_id"],
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {"const": "1.0", "type": "string"},
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "answer_scope": {"type": "string", "enum": ["general_customs_guidance", "clarification_needed", "insufficient_evidence", "out_of_scope"]},
    "direct_answer": {"type": "string", "minLength": 1, "maxLength": 4000},
    "citations": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/GuidanceCitation"}},
    "answer_sections": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/AnswerSection"}},
    "suggested_questions": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "coverage": {"type": "string", "enum": ["covered", "no_coverage", "partial", "unavailable"]},
    "snapshot_id": {"type": ["string", "null"], "maxLength": 512},
    "as_of": {"type": "string", "format": "date"},
    "engine": {"$ref": "#/$defs/Engine"}
  },
  "required": ["schema_version", "conversation_id", "answer_scope", "direct_answer", "citations", "suggested_questions", "coverage", "snapshot_id", "as_of", "engine"],
  "title": "Customs AI Agent official-trade knowledge answer response",
  "type": "object"
}
