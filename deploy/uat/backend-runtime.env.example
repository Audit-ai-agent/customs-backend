# Repository-owned configuration contract only. Copy to _local/secrets and replace
# every <...> value; do not commit the resulting file.
CUSTOMS_BACKEND_ENVIRONMENT=local_uat
CUSTOMS_BACKEND_PROCESS_ROLE=runtime
CUSTOMS_BACKEND_PUBLIC_BASE_URL=http://127.0.0.1:18088
CUSTOMS_BACKEND_DATABASE_URL=postgresql+psycopg://customs_uat:<runtime-password>@operations-db:5432/customs

CUSTOMS_BACKEND_OIDC_ISSUER=http://127.0.0.1:18088/oidc/realms/customs
CUSTOMS_BACKEND_OIDC_AUDIENCE=customs-workbench-api
CUSTOMS_BACKEND_OIDC_JWKS_URL=http://keycloak:8080/oidc/realms/customs/protocol/openid-connect/certs
CUSTOMS_BACKEND_OIDC_CLIENT_ID=customs-workbench-spa
CUSTOMS_BACKEND_OIDC_AUTHORIZATION_ENDPOINT=http://127.0.0.1:18088/oidc/realms/customs/protocol/openid-connect/auth
CUSTOMS_BACKEND_OIDC_TOKEN_ENDPOINT=http://127.0.0.1:18088/oidc/realms/customs/protocol/openid-connect/token
CUSTOMS_BACKEND_OIDC_END_SESSION_ENDPOINT=http://127.0.0.1:18088/oidc/realms/customs/protocol/openid-connect/logout

CUSTOMS_BACKEND_AGENT_BASE_URL=http://agent-uat:8080
CUSTOMS_BACKEND_AGENT_SERVICE_TOKEN=<shared-local-uat-secret>
CUSTOMS_BACKEND_AGENT_TIMEOUT_SECONDS=435
CUSTOMS_BACKEND_REVIEW_ACTOR_TIME_LIMIT_SECONDS=540
CUSTOMS_BACKEND_JOB_LEASE_SECONDS=600
CUSTOMS_BACKEND_REDIS_URL=redis://redis:6379/0
CUSTOMS_BACKEND_MINIO_ENDPOINT=minio:9000
CUSTOMS_BACKEND_MINIO_ACCESS_KEY=<local-uat-minio-user>
CUSTOMS_BACKEND_MINIO_SECRET_KEY=<local-uat-minio-password>
CUSTOMS_BACKEND_MINIO_BUCKET=customs-uat-documents
CUSTOMS_BACKEND_MINIO_SECURE=false

# These values are non-Production labels displayed to the user. They do not
# promote an Evidence generation or Agent release.
CUSTOMS_BACKEND_UAT_EVIDENCE_PROFILE=preserved-3law-v3-scenario-eval
CUSTOMS_BACKEND_UAT_EVIDENCE_DATA_SOURCE=ACTUAL_POSTGRESQL_QDRANT_NEO4J_READ_ONLY
CUSTOMS_BACKEND_UAT_EVIDENCE_POLICY_MODE=SEALED_TEST_ONLY_ACTUAL_CCCT_HUMAN_ONLY
CUSTOMS_BACKEND_UAT_EVIDENCE_EXPECTED_PRODUCTION_LAW_COUNT=58
CUSTOMS_BACKEND_UAT_EVIDENCE_OBSERVED_LAW_COUNT=3
CUSTOMS_BACKEND_UAT_EVIDENCE_OBSERVED_ARTICLE_COUNT=1007
CUSTOMS_BACKEND_UAT_EVIDENCE_QDRANT_POINT_COUNT=1007
CUSTOMS_BACKEND_UAT_EVIDENCE_NEO4J_ARTICLE_COUNT=1007
CUSTOMS_BACKEND_UAT_EVIDENCE_RAG_QUALITY_EVALUATED=false
CUSTOMS_BACKEND_UAT_PLANNER_MODE=shadow
CUSTOMS_BACKEND_UAT_CLAUDE_MODE=actual
CUSTOMS_BACKEND_AUTO_COMPLETION_ENABLED=false

# Scenario-eval-only external UAT fixtures. Generate these under the harness
# `_local/secrets` directory; never commit private key material or an instantiated env.
CUSTOMS_BACKEND_UAT_ASSERTION_SIGNING_KEY_REGISTRY_PATH=<_local-secrets-absolute-path>/uat/assertion-signing-key-registry.json
CUSTOMS_BACKEND_UAT_ASSERTION_TRUST_STORE_SHA256=<agent-public-trust-store-sha256>
CUSTOMS_BACKEND_UAT_REQUIREMENT_POLICY_FIXTURE_PATH=<_local-secrets-absolute-path>/uat/requirement-policy-fixture.json
CUSTOMS_BACKEND_UAT_REQUIREMENT_POLICY_FIXTURE_SHA256=<policy-fixture-sha256>
CUSTOMS_BACKEND_UAT_EVIDENCE_RUNTIME_V3_SHA256=<exact-data-runtime-v3-sha256>
CUSTOMS_BACKEND_UAT_EVIDENCE_TRACE_PATH=<_local-state-absolute-path>/runtime/local-user-uat/three-law-scenario-eval-trace.jsonl

# Candidate AgentServicePin values may be injected as one complete set by the
# workspace harness. Production release-only pins, signed policy paths, signing
# keys, and automatic-completion approval values are forbidden in local_uat.
# The explicitly test-only scenario inputs above are the sole exception;
# Settings rejects them for Production and for every other Evidence profile.
