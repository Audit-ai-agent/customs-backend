# The file is an untracked secret; without a release-verified Data policy resolver, assertions
# intentionally remain unsigned even if a key registry is configured.
# CUSTOMS_BACKEND_ASSERTION_SIGNING_KEY_REGISTRY_PATH=/run/customs-secrets/assertion-signing-keys.json
# Exact secret-free Data provider contract generated from clean commit 14cde864.
CUSTOMS_BACKEND_AGENT_EXPECTED_EVIDENCE_PROVIDER_RELEASE=evidence-api-v1.2.0
