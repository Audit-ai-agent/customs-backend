# Leave every release-only value absent for the honest unreleased Production candidate.
# Set all nine together only after sealed Data V2/V3 and approved Claude/profile/trust releases.
# CUSTOMS_BACKEND_AGENT_EXPECTED_MODEL_REVISION=<exact-model-revision>
# CUSTOMS_BACKEND_AGENT_EXPECTED_EVIDENCE_SNAPSHOT_ID=<exact-released-snapshot>
# CUSTOMS_BACKEND_AGENT_EXPECTED_EVIDENCE_RUNTIME_RELEASE_SHA256=<64-lowercase-hex>
# CUSTOMS_BACKEND_AGENT_EXPECTED_EVIDENCE_RUNTIME_V3_SHA256=<64-lowercase-hex>
# CUSTOMS_BACKEND_AGENT_EXPECTED_RELEASE_PROFILE_ID=<exact-approved-profile-id>
# CUSTOMS_BACKEND_AGENT_EXPECTED_RELEASE_PROFILE_SHA256=<64-lowercase-hex>
# CUSTOMS_BACKEND_AGENT_EXPECTED_RELEASE_PROFILE_SUBJECT_SHA256=<64-lowercase-hex>
# CUSTOMS_BACKEND_AGENT_EXPECTED_RELEASE_PROFILE_EVALUATION_REPORT_SHA256=<64-lowercase-hex>
# CUSTOMS_BACKEND_AGENT_EXPECTED_REVIEWER_TRUST_STORE_SHA256=<64-lowercase-hex>
# Mount these three Data-owned artifacts read-only whenever the nine release-only
# pins above are configured. The Backend independently verifies policy hashes,
# both reviewer signatures, and the exact runtime-v3 digest before it can sign.
# CUSTOMS_BACKEND_REQUIREMENT_POLICY_RELEASE_PATH=/run/customs-releases/requirement-policy.json
# CUSTOMS_BACKEND_REQUIREMENT_POLICY_TRUST_STORE_PATH=/run/customs-releases/trusted-reviewers.json
# CUSTOMS_BACKEND_EVIDENCE_RUNTIME_V3_RELEASE_PATH=/run/customs-releases/evidence-runtime-v3.json
CUSTOMS_BACKEND_REDIS_URL=redis://redis:6379/0
CUSTOMS_BACKEND_MINIO_ENDPOINT=minio:9000
CUSTOMS_BACKEND_MINIO_ACCESS_KEY=<secret>
CUSTOMS_BACKEND_MINIO_SECRET_KEY=<secret>
CUSTOMS_BACKEND_MINIO_BUCKET=customs-documents
CUSTOMS_BACKEND_MINIO_SECURE=false
CUSTOMS_BACKEND_AUTO_COMPLETION_ENABLED=false
# Additive TASK-0027 user experience gates. Keep both false outside the exact
# loopback scenario-eval Harness capability profile.
CUSTOMS_BACKEND_ENHANCED_AGENT_EXPERIENCE=false
CUSTOMS_BACKEND_UAT_ADAPTIVE_ACTIVE=false
# Local Harness supplies both only with the short-lived Agent-owned capability.
# CUSTOMS_BACKEND_UAT_EXPECTED_CAPABILITY_SHA256=<sha256>
# CUSTOMS_BACKEND_UAT_EXPECTED_CAPABILITY_FILE_SHA256=<sha256>
CUSTOMS_BACKEND_HUMAN_DECISION_POLICY_RELEASE=backend-human-decision-policy/v1
# Set only after two independent domain approvals and sealed release evidence.
# CUSTOMS_BACKEND_AUTO_COMPLETION_PROFILE_ID=<approved-profile>
# CUSTOMS_BACKEND_AUTO_COMPLETION_APPROVAL_DIGEST=<64-lowercase-hex>
# CUSTOMS_BACKEND_AUTO_COMPLETION_APPROVAL_MANIFEST_PATH=/run/customs-releases/auto-completion-approval.json

# Compose image and infrastructure inputs (exact digest pins are required in production).
CUSTOMS_PUBLIC_HOST=customs.internal.example
CUSTOMS_TLS_DIR=<absolute-path-to-untracked-tls-directory>
CUSTOMS_EVIDENCE_TLS_DIR=<absolute-path-to-untracked-internal-evidence-tls-directory>
CUSTOMS_AGENT_CA_BUNDLE_FILE=<absolute-path-to-system-plus-internal-ca-bundle>
EVIDENCE_REQUIREMENT_POLICY_RELEASE_FILE=<absolute-path-to-reviewed-policy-release-json>
EVIDENCE_TRUSTED_REVIEWERS_FILE=<absolute-path-to-reviewed-trusted-reviewers-json>
CUSTOMS_BACKEND_ENV_FILE=<absolute-path-to-untracked-backend-env>
CUSTOMS_BACKEND_MIGRATION_ENV_FILE=<absolute-path-to-untracked-migration-env-with-customs_migrator-dsn>
CUSTOMS_BACKEND_OUTBOX_ENV_FILE=<absolute-path-to-untracked-outbox-env-with-only-runtime-dsn-and-redis>
# The separate migration env contains only these three Backend values:
# CUSTOMS_BACKEND_ENVIRONMENT=production
# CUSTOMS_BACKEND_PROCESS_ROLE=migration
# CUSTOMS_BACKEND_DATABASE_URL=postgresql+psycopg://customs_migrator:<secret>@operations-db:5432/customs
# The separate outbox env contains only these four Backend values:
# CUSTOMS_BACKEND_ENVIRONMENT=production
# CUSTOMS_BACKEND_PROCESS_ROLE=outbox
# CUSTOMS_BACKEND_DATABASE_URL=postgresql+psycopg://customs_runtime:<secret>@operations-db:5432/customs
# CUSTOMS_BACKEND_REDIS_URL=redis://redis:6379/0
AGENT_ENV_FILE=<absolute-path-to-untracked-agent-env>
DATA_ENV_FILE=<absolute-path-to-untracked-data-env-with-TLS-store-endpoints-and-secrets>
# Production Data stores are not the plaintext diagnostic containers. They are
# operator-provisioned TLS services attached to this dedicated external Docker
# network. Data ProductionSettings independently requires POSTGRES_SSLMODE,
# QDRANT_URL=https + API key, and NEO4J_URI=bolt+s/neo4j+s.
CUSTOMS_DATA_STORE_TLS_NETWORK=customs-data-store-tls
CUSTOMS_DATA_STORE_ACCESS_MODE=read_only
CUSTOMS_DATA_STORE_PERMISSION_ATTESTATION_SHA256=<sha256-of-reviewed-store-permission-evidence>
FRONTEND_IMAGE=<registry/customs-frontend@sha256:...>
BACKEND_IMAGE=<registry/customs-backend@sha256:...>
AGENT_IMAGE=<registry/customs-ai-agent@sha256:...>
DATA_IMAGE=<registry/customs-data-platform@sha256:...>
REVERSE_PROXY_IMAGE=<registry/nginx@sha256:...>
EVIDENCE_PROXY_IMAGE=<registry/nginx@sha256:...>
EGRESS_PROXY_IMAGE=<registry/squid@sha256:...>
KEYCLOAK_IMAGE=<registry/keycloak@sha256:...>
POSTGRES_IMAGE=<registry/postgres@sha256:...>
POSTGRES_MIGRATOR_PASSWORD=<secret>
POSTGRES_RUNTIME_PASSWORD=<different-secret>
REDIS_IMAGE=<registry/redis@sha256:...>
MINIO_IMAGE=<registry/minio@sha256:...>
POSTGRES_PASSWORD=<secret>
KEYCLOAK_ADMIN=<secret>
KEYCLOAK_ADMIN_PASSWORD=<secret>
KEYCLOAK_DB_PASSWORD=<secret>
MINIO_ROOT_USER=<secret>
MINIO_ROOT_PASSWORD=<secret>
CUSTOMS_RELEASE_DIR=<absolute-path-to-untracked-release-manifests>
