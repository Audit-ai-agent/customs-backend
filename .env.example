# Copy to an untracked secret source. Never commit real values.
CUSTOMS_BACKEND_ENVIRONMENT=production
CUSTOMS_BACKEND_PUBLIC_BASE_URL=https://customs.internal.example
CUSTOMS_BACKEND_PROCESS_ROLE=runtime
CUSTOMS_BACKEND_DATABASE_URL=postgresql+psycopg://customs_runtime:<runtime-secret>@operations-db:5432/customs
CUSTOMS_BACKEND_OIDC_ISSUER=https://customs.internal.example/oidc/realms/customs
CUSTOMS_BACKEND_OIDC_AUDIENCE=customs-workbench-api
CUSTOMS_BACKEND_OIDC_JWKS_URL=http://keycloak:8080/oidc/realms/customs/protocol/openid-connect/certs
CUSTOMS_BACKEND_OIDC_CLIENT_ID=customs-workbench-spa
