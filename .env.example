CUSTOMS_BACKEND_OIDC_END_SESSION_ENDPOINT=https://customs.internal.example/oidc/realms/customs/protocol/openid-connect/logout
CUSTOMS_BACKEND_AGENT_BASE_URL=http://agent:8080
